# Build output
build/
build-*/
out/
cmake-build-*/

# CMake
# CTest scratch dir, created by enable_testing() at the root. Note gitignore
# has no trailing-comment syntax — a comment on this line would become part
# of the pattern and match nothing.
Testing/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
compile_commands.json
.cmake/
.cache/

# Qt Creator / IDE
*.user
*.user.*
*.autosave
.qtc_clangd/

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# OS
Thumbs.db
.DS_Store

# Local DB / runtime artifacts
*.sqlite-journal
*.log

# Release packaging output (qt/scripts/release.ps1)
dist/
packaging/vc_redist.x64.exe
packaging/bibles.sqlite
packaging/strongs-dictionary.sqlite
packaging/strongs-bible.sqlite
